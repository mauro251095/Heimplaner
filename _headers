/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-elem 'self'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Warum script-src doppelt:
#   script-src ist die Rueckfalloption fuer aeltere Browser, die die
#   feineren Direktiven nicht kennen. Wo sie bekannt sind, gewinnen sie:
#     script-src-elem 'self'          -> ein eingeschleustes <script> laeuft NICHT,
#                                        und es kann kein fremdes Skript geladen werden
#     script-src-attr 'unsafe-inline' -> die vorhandenen onclick-Attribute laufen weiter
#   Dasselbe Muster fuer style-src: kein eingeschleustes <style>, aber die
#   zahlreichen style="..."-Attribute der App funktionieren.
#
# Der verbliebene Rest waeren eingeschleuste Event-Handler-Attribute. Genau die
# schliesst esc() aus heimplaner-data.js, das " und ' mitescaped.
#
# connect-src 'self' blockt fetch/XHR/WebSocket zu fremden Zielen, ist aber
# NICHT vollstaendig: eine simple Weiterleitung (location.href = 'https://
# irgendwo.tld/?x=' + ...) faellt nicht unter connect-src und wird von keiner
# Direktive hier eingefangen (die dafuer gedachte CSP-Direktive navigate-to
# wird von keinem Browser unterstuetzt). esc() aus heimplaner-data.js bleibt
# damit die eigentliche letzte Verteidigungslinie, nicht diese CSP.

# Die JS- und CSS-Dateien tragen keinen Hash/keine Versionsnummer im Dateinamen
# (kein Build-Schritt) - ohne explizite Regel entscheidet CDN/Browser nach
# eigenen, fuer uns nicht einsehbaren Heuristiken, wie lange eine Version im
# Cache bleibt. Das heisst: nach einem Deploy mit einem Bugfix waere nicht
# garantiert, wann jedes Geraet die neue Version bekommt. no-cache erzwingt
# eine Revalidierung bei jedem Laden (nicht "gar kein Caching" - der Server
# kann per ETag weiterhin mit 304 antworten, wenn sich nichts geaendert hat).
#
# Jede Datei steht einzeln da, statt sich auf ein Platzhalter-Muster zu
# verlassen: die Dateinamen heissen seit der Ablösung der alten Version nicht
# mehr einheitlich, und eine Regel, die still nicht greift, faellt erst auf,
# wenn ein Geraet tagelang eine alte Fassung zeigt.
# NEUE DATEI HINZUGEFUEGT? Dann hier eine Zeile ergaenzen.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache
/tasks.js
  Cache-Control: no-cache
/heute.js
  Cache-Control: no-cache
/planer.js
  Cache-Control: no-cache
/shop.js
  Cache-Control: no-cache
/budget.js
  Cache-Control: no-cache
/meals.js
  Cache-Control: no-cache
/notes.js
  Cache-Control: no-cache
/birthdays.js
  Cache-Control: no-cache
/settings.js
  Cache-Control: no-cache

/heimplaner-data.js
  Cache-Control: no-cache
/heimplaner-login.js
  Cache-Control: no-cache
/heimplaner-sync.js
  Cache-Control: no-cache
/heimplaner-pwa.js
  Cache-Control: no-cache

/app.css
  Cache-Control: no-cache
/tokens.css
  Cache-Control: no-cache

# Die Icons sind einzelne SVG-Dateien, die sich praktisch nie aendern - hier
# waere eine Revalidierung bei jedem Laden nur unnoetiger Verkehr.
/icons/*
  Cache-Control: public, max-age=604800

# Das App-Icon dagegen kurz halten: es aendert sich selten, aber wenn, dann
# soll es auch ankommen.
/icon-192.png
  Cache-Control: public, max-age=3600
/icon-512.png
  Cache-Control: public, max-age=3600
/icon-maskable-192.png
  Cache-Control: public, max-age=3600
/icon-maskable-512.png
  Cache-Control: public, max-age=3600
